# Set library paths
set search_path ". ./rtl"
set target_library "typical.lib"
set link_library "* typical.lib"

# Read RTL
read_hdl rtl/dma_top.v
read_hdl rtl/dma_controller.v
read_hdl rtl/dma_registers.v

# Elaborate design
elaborate dma_top

# Link design
link

# Read constraints
read_sdc sdc/dma_constraints.sdc

# Compile (synthesis)
compile_ultra

# Reports
report_area > reports/area.rpt
report_timing > reports/timing.rpt
report_power > reports/power.rpt


